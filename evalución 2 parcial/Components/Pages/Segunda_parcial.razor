@page "/segunda_parcial"@rendermode InteractiveServer<h3>Registro de productos</h3><div class="mb-3">    <label class="form-label">No. de inventario</label>    <input type="number" class="form-control" @bind="noInventario" /></div><div class="mb-3">    <label class="form-label">Descripción</label>    <input type="text" class="form-control" placeholder="Escribe la descripción del producto" @bind="descripcion" /></div><div class="mb-3">    <label class="form-label d-block">Departamento</label>    <div class="form-check form-check-inline">        <input class="form-check-input" type="radio" name="depaGroup" id="frutas" value="Frutas" checked="@(departamento == "Frutas")" @onchange='() => departamento = "Frutas"' />        <label class="form-check-label" for="frutas">Frutas</label>    </div>    <div class="form-check form-check-inline">        <input class="form-check-input" type="radio" name="depaGroup" id="verduras" value="Verduras" checked="@(departamento == "Verduras")" @onchange='() => departamento = "Verduras"' />        <label class="form-check-label" for="verduras">Verduras</label>    </div>    <div class="form-check form-check-inline">        <input class="form-check-input" type="radio" name="depaGroup" id="lacteos" value="Lácteos" checked="@(departamento == "Lácteos")" @onchange='() => departamento = "Lácteos"' />        <label class="form-check-label" for="lacteos">Lácteos</label>    </div></div>@if (!string.IsNullOrEmpty(mensajeError)){    <div class="alert alert-danger" role="alert">        @mensajeError    </div>}<div class="mb-3">    <button class="btn btn-success me-1" @onclick="GuardarDatos">Guardar datos</button>    <button class="btn btn-success me-1" @onclick="MostrarListaCompleta">Lista completa</button>    <button class="btn btn-success me-1" @onclick='() => FiltrarPorDepartamento("Frutas")'>Lista de frutas</button>    <button class="btn btn-success me-1" @onclick='() => FiltrarPorDepartamento("Verduras")'>Lista de verduras</button>    <button class="btn btn-success me-1" @onclick='() => FiltrarPorDepartamento("Lácteos")'>Lista de lácteos</button></div>@if (mostrarTabla){    <table class="table table-striped mt-3">        <thead>            <tr>                <th>No. Inventario</th>                <th>Descripción</th>                <th>Departamento</th>            </tr>        </thead>        <tbody>            @for (int i = 0; i < idsFiltrados.Count; i++)            {                <tr>                    <td>@idsFiltrados[i]</td>                    <td>@descripcionesFiltradas[i]</td>                    <td>@departamentosFiltrados[i]</td>                </tr>            }        </tbody>    </table><button class="btn btn-success mt-2" @onclick="CerrarLista">Cerrar lista</button>}
@code {    private int noInventario = 0;    private string descripcion = "";    private string departamento = "Frutas";    private string mensajeError = ""; private List<int> listaIds = new();    private List<string> listaDescripciones = new();    private List<string> listaDepartamentos = new(); private List<int> idsFiltrados = new();    private List<string> descripcionesFiltradas = new();    private List<string> departamentosFiltrados = new(); private bool mostrarTabla = false; private void GuardarDatos()    {        mensajeError = ""; if (listaIds.Contains(noInventario))        {            mensajeError = "El número de inventario ya existe. Debe ser único.";            return;        }        listaIds.Add(noInventario);
        listaDescripciones.Add(descripcion);        listaDepartamentos.Add(departamento); noInventario = 0;        descripcion = "";        departamento = "Frutas";    }    private void MostrarListaCompleta()
    {        idsFiltrados = listaIds.ToList();        descripcionesFiltradas = listaDescripciones.ToList();        departamentosFiltrados = listaDepartamentos.ToList();        mostrarTabla = true;    }    private void FiltrarPorDepartamento(string depa)
    {        idsFiltrados.Clear();        descripcionesFiltradas.Clear();        departamentosFiltrados.Clear(); for (int i = 0; i < listaDepartamentos.Count; i++)        {            if (listaDepartamentos[i] == depa)            {                idsFiltrados.Add(listaIds[i]);                descripcionesFiltradas.Add(listaDescripciones[i]);                departamentosFiltrados.Add(listaDepartamentos[i]);            }        }        mostrarTabla = true;
    }    private void CerrarLista()
    {        mostrarTabla = false;    }}
